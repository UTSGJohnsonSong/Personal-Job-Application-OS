# ------------------------------------------------------------------
# Personal Job Application OS — example environment.
# Copy to `.env` and fill in. NEVER commit a real .env.
# No real personal data belongs in here.
# ------------------------------------------------------------------

# --- Core API ---
APP_ENV=development
APP_SECRET_KEY=change-me-dev-only-not-a-real-secret
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# --- Database ---
# For local dev/tests a SQLite URL works out of the box:
DATABASE_URL=sqlite+aiosqlite:///./data/job_os.db
# For production use Postgres + pgvector:
# DATABASE_URL=postgresql+asyncpg://job_os:job_os@localhost:5432/job_os

# --- Redis / queue ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (S3-compatible, private) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=job-os-private
S3_REGION=us-east-1

# --- LLM (optional; system runs without it, degrading to rule-based parsing) ---
# Provider is pluggable. Leave blank to disable cloud LLM calls entirely.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# When true, no user PII is ever included in LLM request payloads.
LLM_STRICT_PII_MINIMIZATION=true

# --- Connector politeness ---
CONNECTOR_USER_AGENT=PersonalJobApplicationOS/0.1 (+personal-use)
CONNECTOR_DEFAULT_RATE_LIMIT_PER_MIN=30
CONNECTOR_HTTP_TIMEOUT_SECONDS=20

# --- Email (Gmail/Outlook OAuth) — leave blank until user explicitly connects ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# --- Auth / sessions ---
SESSION_COOKIE_NAME=job_os_session
SESSION_TTL_MINUTES=1440
